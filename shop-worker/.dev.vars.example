# Copy to .dev.vars for local development only.
# .dev.vars is gitignored. Never commit real values.

PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

ADMIN_READ_TOKEN=""
ADMIN_WRITE_TOKEN=""
TURNSTILE_SECRET=""
GITHUB_TOKEN=""

# Optional, free push notification after a confirmed sale.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Legacy local-only bridge. Keep disabled for remote/production deployments.
ALLOW_LEGACY_ADMIN_TOKEN="false"
ADMIN_TOKEN=""

# Live-Besucher (optional, normale Variablen, keine Geheimnisse)
# BESUCHER_TRACKING=aus            # Erfassung komplett abschalten
# BESUCHER_TELEGRAM=wichtig        # wichtig (Standard) | alles | aus
# BESUCHER_TELEGRAM_PRO_STUNDE=40  # Deckel fuer Telegram-Meldungen pro Stunde
# BESUCHER_AUFBEWAHRUNG_TAGE=30    # danach loescht der Cron die Ereignisse
